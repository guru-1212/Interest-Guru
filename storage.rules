rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsMember(memberId) {
      return isSignedIn() && 
        firestore.exists(/databases/(default)/documents/members/$(memberId)) &&
        firestore.get(/databases/(default)/documents/members/$(memberId)).data.ownerId == request.auth.uid;
    }

    function ownsLoan(loanId) {
      return isSignedIn() && 
        firestore.exists(/databases/(default)/documents/loans/$(loanId)) &&
        firestore.get(/databases/(default)/documents/loans/$(loanId)).data.ownerId == request.auth.uid;
    }

    match /members/{memberId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || ownsMember(memberId);
    }

    match /loans/{loanId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || ownsLoan(loanId);
    }
  }
}
